{
  "manifest_version": 3,
  "name": "End Task",
  "version": "1.0.16",
  "description": "一鍵終止分頁 process，釋放記憶體與 CPU 資源",
  "permissions": ["activeTab", "alarms", "processes", "scripting", "storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "End Task"
  },
  "commands": {
    "_execute_action": {
      "description": "Activate the extension"
    },
    "end-current-tab": {
      "suggested_key": {
        "default": "Ctrl+E",
        "mac": "Command+E"
      },
      "description": "終止當前分頁的 process"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
